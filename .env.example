# Copy to .env.local, fill only the providers you will run, then load it into
# your shell. .env.local is ignored; this example intentionally contains no
# values. The runner never accepts keys on its command line.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Used only for authenticated Gradia conformance/release work, never for model
# providers. Keep each credential in the process that needs it.
GRADIA_API_TOKEN=
